/*@!Encoding:65001*/
includes
{
  
}

variables
{
  const int kDeltaT         = 10;           // sampling rate of engine
  const double kDeltaTInSec = kDeltaT / 1000.0;
  int IgnitionState = 0;       // 시동 상태 (0: 꺼짐, 1: 켜짐)
  double gRPM;             // 입력된 RPM 값
  int gGear;               // 현재 기어 (1~5)
  double gSpeed;           // 차량 속도 (m/s)
  double gEngSpeed;        // 엔진 회전수 (rev/sec)
  double gForce;           // 추진력
  int cruiseState;
  
  /*force 를 계산하기 위한 상수*/
  double kAirFriction       = 0.6;          // F = kFriction*v*v
  double kRollingFriction   = 100.0;        // Newton
  double kMass = 800.0;    // 차량 질량 (kg)
  
  msTimer TCUSystemClockTimer;
  
  message P_CAN::msg_tcu_info tcuInfoMsg;
  message P_CAN::msg_ieb_brake IEB_PCAN;
}
